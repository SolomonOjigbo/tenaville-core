{
  "name": "@tenaville/core",
  "version": "0.0.0",
  "private": true,
  "description": "Domain modules for the Tenaville modular monolith. Business rules live here, not in route handlers.",
  "type": "module",
  "exports": {
    "./*": "./src/modules/*/application/index.ts"
  },
  "scripts": {
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tenaville/db": "workspace:*",
    "@tenaville/money": "workspace:*",
    "@tenaville/validation": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tenaville/config": "workspace:*"
  }
}
