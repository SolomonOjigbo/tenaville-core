{
  "name": "@tenaville/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Tenaville design tokens and primitives. tokens.json is the source of truth; the CSS variables and React Native themes are checked against it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./native": "./src/native/theme.ts",
    "./tailwind": "./tailwind/tailwind.preset.cjs"
  },
  "scripts": {
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tenaville/config": "workspace:*"
  }
}
