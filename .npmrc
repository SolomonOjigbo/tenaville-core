# Do not auto-install peer dependencies.
#
# Expo pins an SDK-matched version for each of its packages. With
# auto-install-peers on (pnpm's default), expo-router's peers resolve to the
# newest published version instead — which is how @react-native/metro-config
# 0.88 and react-native-worklets 0.13 landed in a project on SDK 57, against
# ranges that want 0.87 and <=0.10.
#
# Declare what the apps actually use, at the version the SDK expects, with
# `npx expo install <pkg>` in apps/mobile. Unused peers then show as warnings
# rather than as silently wrong versions.
auto-install-peers=false

# Flaky-registry tolerance: this project has hit repeated ECONNRESET mid-tarball.
fetch-retries=10
fetch-retry-maxtimeout=120000
