{
  "name": "tenaville",
  "private": true,
  "version": "0.0.0",
  "description": "Tenaville \u2014 property management platform for Nigerian agencies, property managers and landlords",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "pnpm --filter @tenaville/db test:isolation",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,sql}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > packages/db/src/generated/database.types.ts",
    "db:lint": "supabase db lint",
    "docs:reqs": "node tools/check-traceability.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "prettier-plugin-sql": "^0.18.1",
    "supabase": "^1.200.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
