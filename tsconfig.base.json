{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@tenaville/core/*": ["./packages/core/src/*"],
      "@tenaville/db": ["./packages/db/src/index.ts"],
      "@tenaville/money": ["./packages/money/src/index.ts"],
      "@tenaville/validation": ["./packages/validation/src/index.ts"],
      "@tenaville/adapters/*": ["./packages/adapters/src/*"],
      "@tenaville/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
