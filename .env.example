# ---------------------------------------------------------------------------
# Tenaville environment template. Copy to .env.local and fill in.
# Never commit a real .env. Secrets live in the hosting provider's secret store.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
# Display timezone (PRD §10.6: store UTC, display West Africa Time)
APP_TIMEZONE=Africa/Lagos
APP_DEFAULT_CURRENCY=NGN

# --- Supabase (Postgres + Auth + Storage) ----------------------------------
# Local values are printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# sslmode=disable: the local stack does not offer TLS, and the Supabase CLI
# refuses to fall back (psql does so silently).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# --- Storage (private buckets, signed URLs only — PRD DOC-7) ---------------
STORAGE_BUCKET_DOCUMENTS=tenaville-documents
STORAGE_BUCKET_MAINTENANCE=tenaville-maintenance
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Messaging providers (R1 abstraction, PRD COMMS-2) ---------------------
MESSAGING_DEFAULT_CHANNEL=sms
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Payments (R2, licensed partner only — PRD RENT-8) --------------------
# Leave blank in R1. Manual payment recording is the R1 path.
PAYMENTS_PROVIDER=
PAYMENTS_PUBLIC_KEY=
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# --- Subscription billing (PRD BILL-2) ------------------------------------
BILLING_PROVIDER=
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=

# --- Financing partner (R3, disabled by default — PRD §16.4) --------------
FEATURE_FINANCING_ENABLED=false
FINANCING_PROVIDER=
FINANCING_API_KEY=
FINANCING_WEBHOOK_SECRET=

# --- Feature flags (release gating, PRD §6) -------------------------------
FEATURE_CRM_ENABLED=false
FEATURE_SCREENING_ENABLED=false
FEATURE_MAINTENANCE_APPROVALS_ENABLED=false
FEATURE_PAYMENT_AUTOMATION_ENABLED=false
FEATURE_TAX_LINES_ENABLED=false

# --- Document malware scanning (DOC-6) ------------------------------------
# Optional HTTP scanner. POST the file bytes; return JSON {clean, engine, detail}.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

# --- Observability --------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
